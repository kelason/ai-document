# Public Supabase project URL and anonymous key. Never expose the service key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for restricted temporary/rate-limit operations and administrative jobs.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical application origin; HTTPS is required in production. Add exact callback URL in Supabase.
APP_ORIGIN=http://localhost:3000
# Independent, cryptographically random secrets of at least 32 bytes. Do not commit real values.
CSRF_SECRET=
RATE_LIMIT_SECRET=
# Only a header overwritten by a trusted ingress that blocks direct origin access.
# Allowed: cf-connecting-ip, x-vercel-forwarded-for, x-real-ip
TRUSTED_CLIENT_IP_HEADER=
# Local isolated integration stack only; never production credentials.
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_INBOX_URL=http://127.0.0.1:54324
# Configure Google provider credentials and verified SMTP in Supabase, not in the browser.
# Auth email confirmation must be enabled. Email templates should link to:
# {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email
# {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery
# Auth redirect allowlist: exact APP_ORIGIN/auth/callback; no wildcard production domains.
