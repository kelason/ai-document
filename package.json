{
  "name": "ai-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "supabase db reset --local && supabase test db",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run test:db && npm run test:integration && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.112.4",
    "dompurify": "3.4.17",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "^1.37.0",
    "mammoth": "^1.12.2",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "@types/yauzl": "3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
